# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" on the same page. Not used by any code path today.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site URL — drives metadata, canonicals, the sitemap and OG
# images. Leave blank locally; falls back to the Vercel-injected domain in
# production, then to http://localhost:3000. Set this explicitly once you
# move to a custom domain.
NEXT_PUBLIC_SITE_URL=

# Optional: the content value from Google Search Console's HTML-tag
# verification method.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
