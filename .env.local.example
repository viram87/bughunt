# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" on the same page. Not used by any code path today.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site URL — drives metadata, canonicals, the sitemap and OG
# images. Leave blank locally; falls back to the Vercel-injected domain in
# production, then to http://localhost:3000. Set this explicitly once you
# move to a custom domain.
NEXT_PUBLIC_SITE_URL=

# Optional: the content value from Google Search Console's HTML-tag
# verification method.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Show the "Continue with Google" button. Leave unset (or "false") until the
# Google OAuth consent screen is PUBLISHED — while it is in Testing status only
# emails on the Test users list can sign in, and everyone else gets a raw
# access-denied screen. Publishing requires a homepage and privacy policy on a
# domain you own, which a *.vercel.app subdomain can never be.
# Email sign-up works regardless.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
